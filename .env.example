SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
FRONTEND_URL=http://localhost:5173
PORT=4000
RESEND_API_KEY=
EMAIL_FROM=QMS SaaS <onboarding@resend.dev>
# Optionnel — force le transport d'email : 'gmail' (SMTP Gmail, voir MAIL_* ci-dessous),
# 'resend', ou 'local' (Mailpit, http://127.0.0.1:54324, aucune restriction de destinataire mais
# aucun envoi réel). Par défaut : 'gmail'.
EMAIL_TRANSPORT=
GROQ_API_KEY=

# SMTP Gmail — mot de passe d'application généré sur myaccount.google.com (nécessite la
# validation en 2 étapes activée sur le compte).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=

# Sauvegarde/restauration de la base (schéma public), voir /super-admin > Système.
DATABASE_URL=
BACKUP_RETENTION_DAYS=7

# Google Drive — OAuth client + refresh token dédiés (pas de compte de service : pas de quota
# de stockage Drive propre).
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
