SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
FRONTEND_URL=http://localhost:5173
PORT=4000
RESEND_API_KEY=
EMAIL_FROM=QMS SaaS <onboarding@resend.dev>
# Optionnel — force le transport d'email : 'gmail-api' (API Gmail HTTPS, voir GOOGLE_OAUTH_*
# plus bas), 'resend', 'gmail' (SMTP, voir MAIL_* ci-dessous), ou 'local' (Mailpit,
# http://127.0.0.1:54324, aucune restriction de destinataire mais aucun envoi réel). Sans cette
# variable, le transport est choisi automatiquement par priorité : gmail-api si configuré (seul
# à passer par HTTPS — jamais bloqué par un hébergeur, contrairement au SMTP, bloqué sur Render),
# sinon resend, sinon gmail (SMTP).
EMAIL_TRANSPORT=
GROQ_API_KEY=

# SMTP Gmail (transport 'gmail', repli local uniquement — bloqué en sortie sur la plupart des
# hébergeurs cloud) — mot de passe d'application généré sur myaccount.google.com (nécessite la
# validation en 2 étapes activée sur le compte).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=

# Sauvegarde/restauration de la base (schéma public), voir /super-admin > Système.
DATABASE_URL=
BACKUP_RETENTION_DAYS=7

# Google OAuth — un seul identifiant, deux usages : sauvegarde vers Google Drive
# (googleDriveService.js) et transport 'gmail-api' (email.js, prioritaire par défaut dès qu'il
# est configuré). Le refresh token doit être autorisé avec les DEUX scopes combinés :
# https://www.googleapis.com/auth/drive et https://www.googleapis.com/auth/gmail.send
# (OAuth Playground : coche les deux avant d'échanger le code). Un compte de service ne
# conviendrait pas : pas de quota de stockage Drive propre, et ne peut pas envoyer au nom d'un
# compte Gmail.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
